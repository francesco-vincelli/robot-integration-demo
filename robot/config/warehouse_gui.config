<?xml version="1.0" encoding="UTF-8"?>

<window>
  <width>1600</width>
  <height>900</height>
  <style
    material_theme="Light"
    material_primary="DeepOrange"
    material_accent="LightBlue"
    toolbar_color_light="#f3f3f3"
    toolbar_text_color_light="#111111"
    toolbar_color_dark="#414141"
    toolbar_text_color_dark="#f3f3f3">
  </style>

  <plugin filename="MinimalScene" name="3D View">
    <gz-gui>
      <title>3D View</title>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>

    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.50 0.50 0.50</ambient_light>
    <background_color>0.07 0.09 0.13</background_color>

    <!--
     Development overview camera.
     Final presentation pose will be selected after patrol and attack validation.
    -->
    <camera_pose>
      10.5 -12.0 9.0 0.0 0.55 2.35
    </camera_pose>

    <camera_clip>
      <near>0.10</near>
      <far>1000.0</far>
    </camera_clip>

    <horizontal_fov>70</horizontal_fov>
    <anti_aliasing>4</anti_aliasing>
  </plugin>

  <plugin filename="InteractiveViewControl" name="Interactive view control">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
  </plugin>

  <plugin filename="CameraTracking" name="Camera tracking">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
  </plugin>

  <plugin filename="WorldControl" name="World control">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
  </plugin>

  <plugin filename="WorldStats" name="World stats">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
  </plugin>

  <plugin filename="EntityTree" name="Entity tree">
    <gz-gui>
      <property type="bool" key="showTitleBar">true</property>
      <property type="string" key="state">docked</property>
      <property type="double" key="width">260</property>
    </gz-gui>
  </plugin>

  <plugin filename="ComponentInspector" name="Component inspector">
    <gz-gui>
      <property type="bool" key="showTitleBar">true</property>
      <property type="string" key="state">docked</property>
      <property type="double" key="width">260</property>
    </gz-gui>
  </plugin>
</window>
